<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 1. Add CompWeaponMagazine to all ThingDefs with CE CompAmmoUser -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[comps/li[@Class="CombatExtended.CompProperties_AmmoUser"]]/comps</xpath>
    <value>
      <li Class="CE_MagazineFed.CompProperties_WeaponMagazine" />
    </value>
  </Operation>

  <!-- 2. Add StatPart_MagazineMassBulk to Mass (Bulk base value is set directly via StatWorker.GetBaseValueFor) -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="Mass"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="Mass"]/parts</xpath>
      <value>
        <li Class="CE_MagazineFed.StatPart_MagazineMassBulk" />
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="Mass"]</xpath>
      <value>
        <parts>
          <li Class="CE_MagazineFed.StatPart_MagazineMassBulk" />
        </parts>
      </value>
    </nomatch>
  </Operation>

  <!-- 2b. Add StatPart_MagazineMarketValue to MarketValue -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="MarketValue"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="MarketValue"]/parts</xpath>
      <value>
        <li Class="CE_MagazineFed.StatPart_MagazineMarketValue" />
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="MarketValue"]</xpath>
      <value>
        <parts>
          <li Class="CE_MagazineFed.StatPart_MagazineMarketValue" />
        </parts>
      </value>
    </nomatch>
  </Operation>

  <!-- 3. Add idle magazine packing JobGiver to MainColonistBehaviorCore -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThinkTreeDef[defName="MainColonistBehaviorCore"]/thinkRoot/subNodes/li[@Class="ThinkNode_PrioritySorter"]/subNodes</xpath>
    <value>
      <li Class="CE_MagazineFed.JobGiver_PackMagazines" />
    </value>
  </Operation>

  <!-- 4. Add idle magazine packing JobGiver to player Mechanoid ThinkTree (active only when EnableForMechanoids setting is ON) -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThinkTreeDef[defName="Mechanoid"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalPlayerControlledMech"]/subNodes/li[@Class="ThinkNode_Tagger" and tagToGive="Idle"]/subNodes</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThinkTreeDef[defName="Mechanoid"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalPlayerControlledMech"]/subNodes/li[@Class="ThinkNode_Tagger" and tagToGive="Idle"]/subNodes</xpath>
      <order>Prepend</order>
      <value>
        <li Class="CE_MagazineFed.JobGiver_PackMagazines" />
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThinkTreeDef[defName="Mechanoid"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalPlayerControlledMech"]//li[@Class="ThinkNode_ConditionalWorkMech"]/subNodes/li[@Class="ThinkNode_Tagger" and tagToGive="MiscWork"]/subNodes</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThinkTreeDef[defName="Mechanoid"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalPlayerControlledMech"]//li[@Class="ThinkNode_ConditionalWorkMech"]/subNodes/li[@Class="ThinkNode_Tagger" and tagToGive="MiscWork"]/subNodes</xpath>
      <order>Prepend</order>
      <value>
        <li Class="CE_MagazineFed.JobGiver_PackMagazines" />
      </value>
    </match>
  </Operation>
</Patch>
